# Multi-Document Intelligence Workbench — backend env
PORT=4000
# Comma-separated origins allowed by CORS
CORS_ORIGIN=http://localhost:5173
# Max upload size per file (bytes). 10 MB default.
MAX_UPLOAD_BYTES=10485760
# Max number of files per analysis.
MAX_FILES_PER_UPLOAD=10
# Where the SQLite file lives (relative to backend/ cwd).
DB_PATH=./data/app.db
# Where uploaded files are stored on disk.
UPLOAD_DIR=./uploads
# LLM provider: "mock" is deterministic and needs no API key.
LLM_PROVIDER=mock
